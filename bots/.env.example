# ─── Network ──────────────────────────────────────────────────────────────────
# Comma-separated; the first healthy endpoint is used and later ones are failovers. Prefer a dedicated RPC
# (Alchemy, QuickNode, …). Note: sepolia.base.org has been seen accepting transactions and never forwarding them,
# so keep it last.
RPC_URL=https://base-sepolia-rpc.publicnode.com,https://sepolia.base.org
# Optional: override where the deployment JSON lives (default ../contracts/deployments/<chainId>.json)
# DEPLOYMENTS_FILE=
STATE_DIR=./.state
# Max blocks per eth_getLogs (public Base RPC: 1000)
LOG_BLOCK_RANGE=500
LOG_LEVEL=info
# LOG_FORMAT=json

# ─── Keys (one key per bot process — never share a key between two processes) ───
DEPLOYER_PRIVATE_KEY=   # owner: sim (mock oracle/router), setup, seed
KEEPER_PRIVATE_KEY=     # must match KEEPER used at deploy
OPERATOR_PRIVATE_KEY=   # must match OPERATOR used at deploy (resolver)
# Simulated users. Generate a FRESH mnemonic: well-known test mnemonics are EIP-7702-swept on public testnets.
MAKER_MNEMONIC=
MAKER_COUNT=4
MAKER_INDEX_OFFSET=0
MAKER_GAS_ETH=0.002

# ─── Relayer ──────────────────────────────────────────────────────────────────
RELAYER_URL=http://127.0.0.1:8080
RELAYER_HOST=0.0.0.0
RELAYER_PORT=8080
RELAYER_POLL_MS=4000

# ─── Resolver ─────────────────────────────────────────────────────────────────
RESOLVER_POLL_MS=2000
RESOLVER_MIN_PROFIT_USD=0.01
RESOLVER_MIN_MARGIN_BPS=5
RESOLVER_PROFIT_TOLERANCE_BPS=5000

# ─── Keeper ───────────────────────────────────────────────────────────────────
KEEPER_INTERVAL_MS=60000
KEEPER_APY_WINDOW_SEC=600
KEEPER_REBALANCE_THRESHOLD_BPS=100
KEEPER_QUEUE_HYSTERESIS_PCT=0.25
# Self-custody: min APY gain (pp) and cooldown before moving a wallet's shares to another market
KEEPER_WALLET_MIN_GAIN_PCT=0.25
KEEPER_WALLET_COOLDOWN_SEC=3600
KEEPER_IDLE_BUFFER_BPS=3000
KEEPER_MAX_SWAP_SLIPPAGE_BPS=30
KEEPER_TRUST_SCORES='{"morpho":95,"aave":100,"fluid":85}'

# ─── Maker (simulated order flow) ─────────────────────────────────────────────
MAKER_INTERVAL_MS=15000
MAKER_ORDER_MIN_USD=200
MAKER_ORDER_MAX_USD=3000
MAKER_AUCTION_DURATION_SEC=120
MAKER_AUCTION_DELAY_SEC=2
MAKER_AUCTION_START_PREMIUM_BPS=50
MAKER_AUCTION_MIN_DISCOUNT_BPS=100

# ─── Simulator (mock deployments only) ────────────────────────────────────────
SIM_INTERVAL_MS=30000
# Mirror Chainlink ETH/USD from Base mainnet into the mock oracle (empty → random walk)
PRICE_SOURCE_RPC_URL=https://mainnet.base.org
SIM_ROUTER_SPREAD_BPS=10
SIM_TIME_SCALE=1
SIM_MARKET_APYS='{"morpho":6.5,"aave":4.2,"fluid":5.4,"aaveWeth":2.1}'

# ─── Seed (mock deployments only) ─────────────────────────────────────────────
SEED_A_USD=50000
SEED_B_USD=100000
SEED_MARKET_USD=1000000
# Self-custody LPs (wallets that keep their lending shares and ship an Aqua strategy)
WALLET_LP_COUNT=2
SEED_WALLET_USD=100000

# Optional health endpoint per process (used by docker-compose healthchecks)
# HEALTH_PORT=9100
