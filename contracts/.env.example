# RPCs
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org
ETHERSCAN_API_KEY=

# Roles (default: deployer)
OWNER=
KEEPER=
OPERATOR=

# Parameters
RESERVE_BPS=1500
FLASH_FEE_BPS=5
# AQUA_BUDGET=1000000000000000

# Strategy B
SPREAD_BPS=10
SKEW_BPS=8
MAX_TRADE_BPS=2000
BAND_BPS=500
DEPOSIT_FEE_BPS=5
MAX_REBALANCE_LOSS_BPS=50
# PRICE_MAX_AGE=3600          # default 1h live, 365 days in mock mode

# Live mode only (leave USDC empty on testnets → mock markets are deployed)
# Base mainnet values:
# USDC=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# AAVE_POOL=0xA238Dd80C259a72e81d7e4664a9801593F98d1c5
# AAVE_ATOKEN=0x4e65fE4DbA92790696d040ac24Aa414708F5c0AB
# FLUID_VAULT=0xf42f5795D9ac7e9D757dB633D693cD548Cfd9169
# MORPHO_VAULT=0xc1256Ae5FF1cf2719D4937adb3bbCCab2E00A2Ca
# WETH=0x4200000000000000000000000000000000000006
# AAVE_WETH_ATOKEN=0xD4a0e0b9149BCee3C920d2E00b5dE09138fd8bb7
# ORACLE defaults to Chainlink ETH/USD on Base: 0x71041dddad3595F9CEd3DcCFBe3D1F4b0a16Bb70
# LIMIT_ORDER_PROTOCOL / FUSION_SETTLEMENT default to the canonical 1inch deployments on Base.
# AQUA is auto-detected (canonical 0x1111113CCf1426A8E30e2bfF5E005d929bF6a90a) or deployed if absent.
